{
  "name": "transcircle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm types:worker && tsc -b && vite build && vite build --ssr src/entry-prerender.tsx --outDir .prerender && node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "pnpm types:worker && tsc -b",
    "types:worker": "wrangler types",
    "brand:generate": "node scripts/generate-brand-assets.ts",
    "deploy": "wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "^26.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.140.0"
  }
}
