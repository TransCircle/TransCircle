{
  "name": "transcircle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm types:worker && tsc -b && vite build && vite build --ssr src/entry-prerender.tsx --outDir .prerender && node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "pnpm types:worker && tsc -b",
    "types:worker": "wrangler types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:generate": "node scripts/generate-brand-assets.ts",
    "deploy": "pnpm build && wrangler deploy && node scripts/indexnow.ts",
    "seo:indexnow": "node scripts/indexnow.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "^26.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.34.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.140.0"
  }
}
