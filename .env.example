# TransCircle 导航站（Pass 门户）前端环境变量
# 复制为 .env（本地）/ .env.production（生产构建）后填值。
# 注意：Vite 只暴露 VITE_ 前缀的变量给前端；这些值会打进产物，勿放机密。

# Pass 后端基址。
# - 留空：走相对路径 /v1、/oauth2，由 vite.config.ts 的 server.proxy 转发。
#   **仅限本地开发**：那条相对路径在生产上不存在（见下方警告）。
# - 生产/跨域：填 Pass 后端对外绝对地址，前端以 credentials:'include' 直连。
#   例：VITE_PASS_API_BASE=https://api.transcircle.org/pass
#   （此时 Pass 后端 CORS 需允许本门户来源且 Allow-Credentials:true）
#
# ⚠️ 生产必须填！Cloudflare Worker（worker/index.ts）目前**不代理** /v1、/oauth2、
#    /.well-known —— 生产构建必须走绝对地址直连，否则门户登录/注册/账户全线不可用。
#    另：即便想改回同源代理，也不能直接开：Pass 的 refresh cookie path 是
#    `withBasePath('/v1/auth')`，生产为 /pass/v1/auth，浏览器请求 /v1/auth/refresh 时
#    根本不会带上这枚 cookie。要同源就得同时改 Pass 的 cookie path。
VITE_PASS_API_BASE=

# Cloudflare Turnstile 人机验证 Site Key（从 Cloudflare 控制台获取）
VITE_TURNSTILE_SITE_KEY=
